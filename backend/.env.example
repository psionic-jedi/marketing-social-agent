# ================================================
# Marketing Agent System - Environment Configuration
# ================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# REQUIRED values are marked below
# OPTIONAL values have sensible defaults
# ================================================

# ----- API Keys [REQUIRED] -----
# Get from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Get from https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key-here

# ----- Database [REQUIRED] -----
# For Docker Compose (container hostnames):
#   DATABASE_URL=postgresql://marketing_user:marketing_pass@postgres:5432/marketing_agents
# For local development (localhost):
DATABASE_URL=postgresql://marketing_user:marketing_pass@localhost:5432/marketing_agents

# ----- Application Security [REQUIRED] -----
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-change-this

# ----- Redis -----
# For Docker Compose: redis://redis:6379/0
# For local: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# ----- Storage -----
STORAGE_TYPE=local
LOCAL_STORAGE_PATH=./storage

# ----- Application -----
DEBUG=true
ENVIRONMENT=development
LOG_LEVEL=INFO

# ----- CORS -----
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ----- Agent Configuration -----
USE_REAL_SCRAPING=true
DEFAULT_TEMPERATURE=0.7
MAX_TOKENS=4000

# ----- Performance -----
MAX_CONCURRENT_CAMPAIGNS=10
CAMPAIGN_TIMEOUT_MINUTES=15

# ================================================
# OPTIONAL - Only needed for specific features
# ================================================

# ----- AWS S3 Storage (if STORAGE_TYPE=s3) -----
# S3_BUCKET=marketing-agents-production
# AWS_REGION=eu-west-2
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# ----- SMTP (for email features) -----
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
