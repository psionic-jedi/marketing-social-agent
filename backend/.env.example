# ================================
# Development Environment Example
# ================================
# Copy this to .env.development for local development

# API Keys
ANTHROPIC_API_KEY=sk-ant-your-key-here
GOOGLE_API_KEY=your-google-api-key-here

# Database (Local Development)
DATABASE_URL=postgresql://marketing_user:marketing_pass@localhost:5432/marketing_agents

# Redis (Local Development)
REDIS_URL=redis://localhost:6379/0

# Storage Configuration
STORAGE_TYPE=local
LOCAL_STORAGE_PATH=./storage

# App Configuration
SECRET_KEY=your-secret-key-for-jwt
DEBUG=true
ENVIRONMENT=development
LOG_LEVEL=INFO

# CORS (for local frontend)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ================================
# Production Environment
# ================================
# For production, create .env.production with these settings:

# STORAGE_TYPE=s3
# S3_BUCKET=marketing-agents-production
# AWS_REGION=eu-west-2
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# DATABASE_URL=postgresql://user:pass@rds-endpoint:5432/marketing_agents
# REDIS_URL=redis://elasticache-endpoint:6379/0

# DEBUG=false
# ENVIRONMENT=production
# ALLOWED_ORIGINS=https://yourdomain.com

# Optional: SMTP for test emails
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
