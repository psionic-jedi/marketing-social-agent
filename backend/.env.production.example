# ================================
# Production Environment
# ================================
# Copy this to .env and fill in real values

# API Keys
ANTHROPIC_API_KEY=sk-ant-CHANGE-ME
GOOGLE_API_KEY=CHANGE-ME

# Database (must match POSTGRES_PASSWORD in root .env)
DATABASE_URL=postgresql://marketing_user:CHANGE-ME@postgres:5432/marketing_agents

# Redis (must match REDIS_PASSWORD in root .env)
REDIS_URL=redis://:CHANGE-ME@redis:6379/0

# Storage
STORAGE_TYPE=local
LOCAL_STORAGE_PATH=/app/storage

# App Configuration - CHANGE the secret key!
SECRET_KEY=CHANGE-ME-generate-with-python3-c-import-secrets-print-secrets-token_hex-32
DEBUG=false
ENVIRONMENT=production
LOG_LEVEL=INFO

# CORS - set to your actual domain
ALLOWED_ORIGINS=https://yourdomain.com,http://yourdomain.com
