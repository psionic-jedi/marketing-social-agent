# ================================
# Docker Compose Production Variables
# ================================
# Copy this to .env in the project root

# Database credentials
POSTGRES_DB=marketing_agents
POSTGRES_USER=marketing_user
POSTGRES_PASSWORD=CHANGE-ME-use-a-strong-password

# Redis password
REDIS_PASSWORD=CHANGE-ME-use-a-strong-password

# Frontend build-time variable
REACT_APP_API_URL=/api
